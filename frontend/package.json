{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && stylelint \"src/**/*.{vue,scss}\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.{vue,scss}\" --fix"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.23",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "^31.0.1",
    "postcss-html": "^2.0.1",
    "sass": "^1.108.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-selector-bem-pattern": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
